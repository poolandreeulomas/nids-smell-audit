# Required: OpenAI API credentials
OPENAI_API_KEY=your_openai_api_key_here

# Default Model & Sampling Temperature
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TEMPERATURE=0.0

# Batch Runtime Orchestration (Optional)
# PHASE3A_MAX_ROUNDS=3
# PHASE3A_EXECUTION_MODE=full_batch  # Options: full_batch, full_round, dry_run
# PHASE3A_ENABLE_CRITIC=1            # Enable/disable critic agent (1 or 0)
# PHASE3A_PLANNING_MODEL=gpt-4.1
# PHASE3A_WORKER_MODEL=gpt-4.1-mini
# PHASE3A_SYNTHESIS_MODEL=gpt-4.1

# Headless / Dataset Path (Optional for main.py)
# NIDS_DATASET_PATH=
